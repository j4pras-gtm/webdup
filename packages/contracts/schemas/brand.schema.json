{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sidekikz-builder/schemas/brand.schema.json",
  "title": "BrandTokens",
  "description": "Machine-readable brand contract extracted by P2-brand-extract and consumed by every build.",
  "type": "object",
  "required": [
    "name",
    "colors",
    "typography",
    "logo"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Client/brand display name"
    },
    "palette": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "description": "hex"
        },
        "secondary": {
          "type": "string",
          "description": "hex"
        },
        "accent": {
          "type": "string",
          "description": "hex"
        },
        "background": {
          "type": "string",
          "description": "hex"
        },
        "text": {
          "type": "string",
          "description": "hex"
        }
      },
      "required": [
        "primary",
        "secondary",
        "accent",
        "background",
        "text"
      ]
    },
    "typography": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    },
    "logo_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "description": "where tokens were extracted from"
    },
    "personalization_group": {
      "type": "string"
    }
  }
}
