{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sidekikz-builder/schemas/qa-report.schema.json",
  "title": "QaReport",
  "description": "Per-build QA gate result. Written to <build>/qa/qa.json and copied to <build>/qa/ on pass.",
  "type": "object",
  "required": ["build_id", "passed", "checks_run", "checked_at"],
  "properties": {
    "build_id":     { "type": "string" },
    "passed":       { "type": "boolean" },
    "checks_run":   { "type": "integer" },
    "checked_at":   { "type": "string", "format": "date-time" },
    "artifacts":    { "type": "array", "items": { "type": "string" } },
    "errors":       { "type": "array", "items": { "type": "string" } },
    "meta":         { "type": "object" }
  }
}
